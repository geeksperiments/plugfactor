# Neo4j AuraDB Credentials
NEO4J_URI=neo4j+s://REPLACE_WITH_INSTANCE_ID.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=REPLACE_WITH_NEO4J_PASSWORD
NEO4J_DATABASE=neo4j

# Daytona Cloud Sandbox Credentials
DAYTONA_SANDBOX_ID=REPLACE_WITH_SANDBOX_UUID
DAYTONA_SANDBOX_NAME=hacksprint
DAYTONA_SNAPSHOT=daytonaio/sandbox:0.11.0
DAYTONA_TARGET=eu
DAYTONA_SSH_USER=REPLACE_WITH_DAYTONA_SSH_TOKEN
DAYTONA_SSH_HOST=ssh.app.daytona.io
DAYTONA_API_KEY=REPLACE_WITH_DAYTONA_API_KEY
DAYTONA_API_URL=https://app.daytona.io/api

# Nosana Decentralized GPU Inference
NOSANA_BASE_URL=https://api.nosana.io/v1
NOSANA_API_KEY=REPLACE_WITH_NOSANA_API_KEY
NOSANA_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
NOSANA_PROTECT_CREDITS=true

# Local Studio Port
PORT=8080
